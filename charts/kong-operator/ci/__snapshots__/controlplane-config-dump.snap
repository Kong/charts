# Source: kong-operator/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/name: kong-operator
    helm.sh/chart: kong-operator-1.5.0-rapid.1
    app.kubernetes.io/instance: "chartsnap"
    app.kubernetes.io/version: "2.4.0-rapid.1"
    app.kubernetes.io/component: ko
  name: chartsnap-kong-operator-controller-manager
  namespace: default
  annotations:
    # Env vars: KONG_OPERATOR_CLUSTER_CA_SECRET and KONG_OPERATOR_CLUSTER_CA_SECRET_NAMESPACE are set for this Deployment.
    # These env vars don't contain any sensitive data. They just reference the name and namespace of the Secret that holds
    # the CA certificate. Thus, it's safe to disable linter check (unfortunately, it has to be done this way since kube-linter
    # doesn't support disabling specific checks for specific env vars only).
    ignore-check.kube-linter.io/env-var-secret: "It's safe to reference CA related Secrets by name and namespace in env var"
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: kong-operator
      app.kubernetes.io/component: ko
      app.kubernetes.io/instance: "chartsnap"
  strategy:
    type: Recreate
  template:
    metadata:
      annotations:
        kubectl.kubernetes.io/default-container: manager
      labels:
        control-plane: controller-manager
        app.kubernetes.io/name: kong-operator
        helm.sh/chart: kong-operator-1.5.0-rapid.1
        app.kubernetes.io/instance: "chartsnap"
        app.kubernetes.io/version: "2.4.0-rapid.1"
        app.kubernetes.io/component: ko
        app: chartsnap-kong-operator
        version: "2.4.0-rapid.1"
    spec:
      containers:
      - name: manager
        env:
        - name: KONG_OPERATOR_ANONYMOUS_REPORTS
          value: "false"
        - name: KONG_OPERATOR_ENABLE_CONTROLLER_GATEWAY
          value: "true"
        - name: KONG_OPERATOR_NO_LEADER_ELECTION
          value: "true"
        - name: KONG_OPERATOR_CLUSTER_CA_SECRET
          value: "kong-operator-ca"
        - name: KONG_OPERATOR_CLUSTER_CA_SECRET_NAMESPACE
          value: "default"
        - name: KONG_OPERATOR_CONTROLPLANE_CONFIG_DUMP_BIND_ADDRESS
          value: ":10256"
        - name: KONG_OPERATOR_ENABLE_CONTROLPLANE_CONFIG_DUMP
          value: "true"
        - name: KONG_OPERATOR_HEALTH_PROBE_BIND_ADDRESS
          value: ":8081"
        - name: KONG_OPERATOR_METRICS_BIND_ADDRESS
          value: "0.0.0.0:8080"
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        image: docker.io/kong/kong-operator:2.4.0-rapid.1
        livenessProbe:
          httpGet:
            path: /healthz
            port: 8081
          initialDelaySeconds: 1
          periodSeconds: 1
        readinessProbe:
          httpGet:
            path: /readyz
            port: 8081
          initialDelaySeconds: 1
          periodSeconds: 1
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 10m
            memory: 128Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
          capabilities:
            drop:
            - ALL
        ports:
        - containerPort: 8081
          name: probe
          protocol: TCP
        - containerPort: 8080
          name: metrics
          protocol: TCP
        - containerPort: 9443
          name: webhook-server
          protocol: TCP
        - containerPort: 5443
          name: admission
          protocol: TCP
        volumeMounts:
        - name: webhook-certs
          mountPath: /tmp/k8s-webhook-server/serving-certs
          readOnly: true
        - name: validating-webhook-certs
          mountPath: /tmp/k8s-webhook-server/serving-certs/validating-admission-webhook
          readOnly: true
        - name: pod-labels
          mountPath: /etc/podinfo
      securityContext:
        runAsNonRoot: true
      serviceAccountName: controller-manager
      terminationGracePeriodSeconds: 10
      volumes:
      - name: webhook-certs
        secret:
          defaultMode: 420
          secretName: chartsnap-kong-operator-webhook-server-cert
      - name: validating-webhook-certs
        secret:
          defaultMode: 420
          secretName: chartsnap-kong-operator-webhook-validating-server-cert
      - name: pod-labels
        downwardAPI:
          items:
          - path: labels
            fieldRef:
              fieldPath: metadata.labels
---
